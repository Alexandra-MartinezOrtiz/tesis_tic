{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity_auth": {
        "ClusterId": "identity_cluster",
        "Match": { "Path": "/api/auth/{**remainder}" }
      },
      "identity_usuarios": {
        "ClusterId": "identity_cluster",
        "Match": { "Path": "/api/usuarios/{**remainder}" }
      },
      "propuestas": {
        "ClusterId": "propuestas_cluster",
        "Match": { "Path": "/api/propuestas/{**remainder}" }
      },
      "reportes": {
        "ClusterId": "reportes_cluster",
        "Match": { "Path": "/api/reportes/{**remainder}" }
      }
    },
    "Clusters": {
      "identity_cluster": {
        "Destinations": {
          "identity": { "Address": "http://localhost:5001/" }
        }
      },
      "propuestas_cluster": {
        "Destinations": {
          "propuestas": { "Address": "http://localhost:5002/" }
        }
      },
      "reportes_cluster": {
        "Destinations": {
          "reportes": { "Address": "http://localhost:5003/" }
        }
      }
    }
  }
}
